// Signing settings shared by every target.
//
// Your Apple team ID is personal, so it is NOT stored here or in project.pbxproj (a pull would
// reset it). It lives in Config/Local.xcconfig, which git ignores. Make that file once with:
//
//     scripts/setup-signing.sh
//
// or copy Config/Local.xcconfig.template to Config/Local.xcconfig and fill in your team ID.

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

// "#include?" means: use the file if it's there, carry on quietly if not (CI has no team).
#include? "Local.xcconfig"
